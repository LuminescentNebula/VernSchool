    "x = [i*0.01 for i in range(2000)]\n",
    "y = [math.sin(i) for i in x]\n",
    "y2 = [math.cos(i) for i in x]\n",
    "plt.plot(x, y, label=\"sin\")\n",
    "plt.plot(x, y2, label=\"cos\") \n",
    "\n",
    "plt.legend()\n",
    "\n",
    "plt.show()"
   ]
